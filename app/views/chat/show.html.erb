<%= csrf_meta_tags %>
<% if @ticket %>
  <h1><%= @ticket.subject %></h1>
  <% if @human_only %>
    <aside role="status" aria-label="Human support escalation"><%= AiIncidentControl.config.fetch('message') %></aside>
  <% end %>
  <aside aria-label="Realtime voice">
    <p>Realtime voice uses ticket-bound credentials. Spoken approval never executes an action.</p>
    <p>The local voice client verifies interruption and evidence events; browser audio acceptance is separate.</p>
  </aside>
  <p>Only sanitized evidence is retained. Re-upload is required after extraction failure.</p>
  <%= form_with url: ticket_attachments_path(ticket_id: @ticket.id), multipart: true do |form| %>
    <%= form.label :kind, 'Attachment kind' %>
    <%= form.select :kind, [['Screenshot', 'screenshot'], ['Scanned page', 'scanned_page'], ['Recorded voice call', 'voice']] %>
    <%= form.file_field :file, required: true %>
    <%= form.submit 'Upload and process' %>
  <% end %>
  <p>Reload this ticket after background processing.</p>
  <% @attachments.each do |item| %>
    <section aria-label="Attachment <%= item.id %>">
      <h2>Attachment <%= item.id %>: <%= item.status %></h2>
      <% if item.offline_fixture %><p>Offline fixture; real vision/OCR/speech quality not verified.</p><% end %>
      <p role="status"><%= item.notice %></p>
      <p><%= item.answer['answer'] %></p>
      <ul>
        <% item.answer.fetch('citations', []).each do |citation| %>
          <li>
            <%= link_to "Attachment #{citation['attachment_id']}, page #{citation['page']}, region #{citation['region']}",
              ticket_attachment_evidence_path(ticket_id: @ticket.id, id: item.id) %>
            <q><%= citation['span'] %></q>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>
<% end %>
<h1>Anchor chat</h1>
<form id="chat-form">
  <label>Message <input id="message" value="When will my refund arrive?" required></label>
  <button id="send">Send / retry as new request</button>
</form>
<button id="stop" type="button" disabled>Stop</button>
<p id="state" role="status">Ready</p>
<pre id="answer" style="white-space: pre-wrap"></pre>
<ul id="citations" aria-label="Citations"></ul>
<form id="feedback-form" hidden>
  <label>What was wrong? <input id="feedback-comment" maxlength="2000"></label>
  <button type="submit">Thumbs down</button>
  <span id="feedback-state" role="status"></span>
</form>
<script>
(() => {
  const find = id => document.getElementById(id);
  const state = find('state'), answer = find('answer'), citations = find('citations');
  const send = find('send'), stop = find('stop');
  const csrf = () => document.querySelector('meta[name="csrf-token"]').content;
  const citedMode = <%= GoldenCandidate.verifier.verified(session[:anchor_customer_context].to_s, purpose: 'answer_customer').present? ? 'true' : 'false' %>;
  let messageId;
  let aborter;
  const interrupted = message => {
    state.textContent = message + ' Partial text is unconfirmed. Retry starts a new request.';
    citations.replaceChildren();
  };
  find('feedback-form').addEventListener('submit', async event => {
    event.preventDefault();
    if (!messageId) return;
    try {
      const response = await fetch('/api/answer_feedback', {
        method: 'POST', credentials: 'same-origin',
        headers: {'Content-Type': 'application/json', 'X-CSRF-Token': csrf()},
        body: JSON.stringify({message_id: messageId, rating: 'down', comment: find('feedback-comment').value})
      });
      if (!response.ok) throw new Error('Feedback was not saved. Please retry.');
      find('feedback-state').textContent = 'Saved for review, not added to the golden dataset.';
    } catch (error) { find('feedback-state').textContent = error.message; }
  });
  find('chat-form').addEventListener('submit', async event => {
    event.preventDefault();
    aborter = new AbortController();
    answer.textContent = '';
    citations.replaceChildren();
    messageId = undefined;
    find('feedback-form').hidden = true;
    find('feedback-state').textContent = '';
    send.disabled = true;
    stop.disabled = false;
    state.textContent = 'Drafting — partial output';
    let reader, terminal = false, buffer = '';
    const decoder = new TextDecoder('utf-8', {fatal: true});
    function dispatch(packet) {
      if (packet.startsWith(':')) return;
      if (terminal) throw new Error('Event after terminal event');
      let name = 'message';
      const data = [];
      for (const line of packet.split(/\r?\n/)) {
        if (line.startsWith('event:')) name = line.slice(6).trim();
        if (line.startsWith('data:')) data.push(line.slice(5).replace(/^ /, ''));
      }
      const value = data.join('\n');
      if (name === 'token') answer.textContent += value;
      else if (name === 'final') {
        const reply = JSON.parse(value);
        if (reply.content !== answer.textContent || !Array.isArray(reply.citations) ||
            !reply.citations.every(c => typeof c === 'string') ||
            typeof reply.truncated !== 'boolean') throw new Error('Invalid final reply');
        terminal = true;
        state.textContent = reply.truncated ? 'Cut off — not a full answer.' : 'Finished';
        const sources = reply.citations.length ? reply.citations : ['No source citations attached.'];
        for (const citation of sources) {
          const item = document.createElement('li');
          item.textContent = citation;
          citations.append(item);
        }
      } else if (name === 'error') {
        terminal = true;
        interrupted(JSON.parse(value).message);
      } else throw new Error('Unknown stream event');
    }
    try {
      if (citedMode) {
        state.textContent = 'Searching support knowledge base';
        const response = await fetch('/chat/cited', {
          method: 'POST', credentials: 'same-origin', signal: aborter.signal,
          headers: {'Content-Type': 'application/json', 'Accept': 'application/json', 'X-CSRF-Token': csrf()},
          body: JSON.stringify({message: find('message').value})
        });
        if (!response.ok) throw new Error('Chat HTTP ' + response.status);
        const result = await response.json(), reply = result.cited_answer;
        if (result.handoff === true) {
          answer.textContent = result.reply;
          state.textContent = 'Human support escalation';
          return;
        }
        if (!reply || !['answer', 'hedge', 'refuse'].includes(reply.decision)) throw new Error('Invalid answer');
        answer.textContent = reply.answer;
        state.textContent = {answer: 'Supported answer', hedge: 'Uncertain — check conditions', refuse: 'No supporting answer found'}[reply.decision];
        for (const citation of reply.citations) {
          const item = document.createElement('li');
          item.textContent = 'Chunk ' + citation.chunk_id + ': “' + citation.quoted_span + '”';
          citations.append(item);
        }
        messageId = result.message_id;
        find('feedback-form').hidden = false;
        return;
      }
      const response = await fetch('/chat', {
        method: 'POST', credentials: 'same-origin', signal: aborter.signal,
        headers: {'Content-Type': 'application/json', 'Accept': 'text/event-stream',
          'X-CSRF-Token': csrf()},
        body: JSON.stringify({message: find('message').value})
      });
      if (!response.ok || !response.body ||
          !response.headers.get('Content-Type')?.startsWith('text/event-stream')) {
        throw new Error('Chat HTTP ' + response.status);
      }
      reader = response.body.getReader();
      while (true) {
        const {value, done} = await reader.read();
        buffer += done ? decoder.decode() : decoder.decode(value, {stream: true});
        let boundary;
        while ((boundary = /\r?\n\r?\n/.exec(buffer)) !== null) {
          const packet = buffer.slice(0, boundary.index);
          buffer = buffer.slice(boundary.index + boundary[0].length);
          dispatch(packet);
        }
        if (done) break;
      }
      if (!terminal || buffer.trim()) throw new Error('Stream ended without a terminal frame');
    } catch (error) {
      interrupted(error.name === 'AbortError' ? 'Stopped.' : error.message);
    } finally {
      if (reader) {
        try { await reader.cancel(); } catch (_) {}
        reader.releaseLock();
      }
      send.disabled = false;
      stop.disabled = true;
    }
  });
  stop.addEventListener('click', () => aborter?.abort());
})();
</script>
